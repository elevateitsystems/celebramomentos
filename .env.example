# Copy to .env.local for local development and fill in real values.
# Production values live in Vercel → Project Settings → Environment Variables.
# Never commit real secrets. Only NEXT_PUBLIC_* values are exposed to the browser.

# PostgreSQL (Neon). Prisma CLI commands (db:migrate, db:deploy) read .env, so
# also put DATABASE_URL in .env locally.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# Stripe (server-side only). Use sk_test_/pk_test_ keys locally.
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_SECRET_KEY="sk_test_replace_me"
# Local: from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Production: signing secret of the https://www.celebra-momentos.com/api/stripe/webhook endpoint
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# PayPal Checkout (Orders v2, server-side only — never prefix with NEXT_PUBLIC_).
# Create a REST app at https://developer.paypal.com/dashboard/applications and copy
# its Client ID and Secret. Sandbox and Live apps have different credentials.
PAYPAL_CLIENT_ID="replace_me"
PAYPAL_CLIENT_SECRET="replace_me"
# "sandbox" (default, test payments) or "live" (real payments, Live app credentials)
PAYPAL_MODE="sandbox"

# Cloudinary (server-side only)
CLOUDINARY_CLOUD_NAME="replace_me"
CLOUDINARY_API_KEY="replace_me"
CLOUDINARY_API_SECRET="replace_me"

# Session signing secret, at least 32 characters. Generate with: openssl rand -hex 32
# Use a different value in production.
AUTH_SECRET="replace_with_at_least_32_random_characters"
# Bootstrap owner account for /admin/login. Use a strong password in production.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="12345678"

# SMTP (optional, not used by the app yet)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace_me"
SMTP_PASSWORD="replace_me"
SMTP_FROM="Celebra Momentos <no-reply@example.com>"

# Public base URL used for Stripe and PayPal return/cancel redirects.
# Local: http://localhost:3000   Production: https://www.celebra-momentos.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Print-on-demand (lib/pod) — all server-only, never NEXT_PUBLIC_ ────────────
# "draft" (default): nothing is produced or charged — Gelato draft orders, Printful
# unconfirmed orders, Prodigi sandbox, AlerioPrint not sent. "live": real orders.
POD_ORDER_MODE="draft"
# Send paid orders to the print shops automatically ("false" = an admin sends them).
POD_AUTO_SUBMIT="true"
# Random secret (min. 24 chars) put in the webhook URLs given to the print shops.
# Generate with: openssl rand -hex 24
POD_WEBHOOK_SECRET="replace_with_random_secret"
# Protects /api/cron/pod; Vercel Cron sends it automatically when set in Vercel.
CRON_SECRET="replace_with_random_secret"

# Prodigi (greeting cards, magnets). Live key for POD_ORDER_MODE=live; the sandbox
# (draft mode) needs its own key from the Prodigi sandbox dashboard.
PRODIGI_API_KEY="replace_me"
PRODIGI_SANDBOX_API_KEY="replace_me"
# Optional overrides: https://api.prodigi.com/v4.0 / https://api.sandbox.prodigi.com/v4.0
PRODIGI_BASE_URL=""
PRODIGI_SANDBOX_BASE_URL=""

# Gelato (wall art, calendars, tough phone cases). Optional base URL override.
GELATO_API_KEY="replace_me"
GELATO_BASE_URL=""

# Printful (mugs). Private token + the store the orders go to ("Celebra Momentos Store").
PRINTFUL_PRIVATE_TOKEN="replace_me"
PRINTFUL_STORE_ID="replace_me"
PRINTFUL_BASE_URL=""

# AlerioPrint (clear and MagSafe phone cases). Orders land unpaid in the Alerio cart.
ALERIOPRINT_API_KEY="replace_me"
ALERIOPRINT_BASE_URL=""
# Delivery service id from GET /api/external/deliveries (2 = DHL Global Mail with tracking).
ALERIOPRINT_DELIVERY_OPTION="2"

# Meta Pixel id (public, loaded only after cookie consent).
META_PIXEL_ID="1148694617681361"
