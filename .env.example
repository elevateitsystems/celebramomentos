# Celebra Momentos — environment variables (names + placeholders only; never put real values here).
#
# Local:  copy to .env.local and fill in real values (.env* files are git-ignored).
#         Prisma CLI commands (db:migrate, db:deploy) read .env, so keep DATABASE_URL in .env too.
# Vercel: Project → Settings → Environment Variables. Everything below is server-only except
#         NEXT_PUBLIC_APP_URL (the only value exposed to the browser). Lines starting with "# " are
#         optional or disabled: leave them out unless you need them.
# Placeholders containing "replace" / "changeme" / "example.com" are treated as "not set" by the app.

# ── App & sessions ─────────────────────────────────────────────────────────────
# Public base URL, used for Stripe/PayPal return URLs and print-shop webhook URLs (lib/server/site-url.ts).
# Local: http://localhost:3000. Vercel Production: https://www.celebra-momentos.com. On Vercel Preview leave it
# unset (the deployment URL is used). A localhost value is ignored on a deployed site.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional server-only override of the URL above, read at runtime:
# APP_URL="https://www.celebra-momentos.com"
# Session signing secret, at least 32 characters (openssl rand -hex 32). Use a different one per environment.
AUTH_SECRET="replace_with_at_least_32_random_characters"
# Owner account created at the first /admin/login. Use a strong password in production.
ADMIN_EMAIL="replace_me"
ADMIN_PASSWORD="replace_with_a_strong_password"

# ── Database (PostgreSQL / Neon) ───────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# ── Payments ───────────────────────────────────────────────────────────────────
# Stripe Checkout (hosted page, no publishable key needed). sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY="sk_test_replace_me"
# Signing secret of the endpoint https://<site>/api/stripe/webhook (local: `stripe listen` prints one).
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# PayPal Checkout (Orders v2). Sandbox and Live REST apps have different credentials.
PAYPAL_CLIENT_ID="replace_me"
PAYPAL_CLIENT_SECRET="replace_me"
# "sandbox" (test payments, default) or "live" (real payments)
PAYPAL_MODE="sandbox"

# ── Image storage (Cloudinary) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="replace_me"
CLOUDINARY_API_KEY="replace_me"
CLOUDINARY_API_SECRET="replace_me"
# Alternative to the three above: CLOUDINARY_URL="cloudinary://KEY:SECRET@CLOUD_NAME"

# ── Order confirmation email (optional) ────────────────────────────────────────
# Sent after a verified payment. Disabled while any of host / user / password / from is missing or a
# placeholder; checkout is unaffected either way.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace_me"
SMTP_PASSWORD="replace_me"
SMTP_FROM="Celebra Momentos <no-reply@example.com>"

# ── Analytics (optional, public ids, loaded only after cookie consent) ─────────
# Anything that does not match the id format is ignored.
META_PIXEL_ID="replace_me"
# Google Tag Manager container (GA4 is configured inside it) and the GA4 id it reports to.
GTM_CONTAINER_ID="replace_me"
GA4_MEASUREMENT_ID="replace_me"

# ── Print-on-demand: general (lib/pod) ─────────────────────────────────────────
# "draft" (default) = TEST ONLY: Gelato draft orders, Printful unconfirmed orders, Prodigi sandbox, Printeers
# test server. Nothing is produced or charged. "live" = real production orders: keep "draft" until go-live.
POD_ORDER_MODE="draft"
# Random secret (24+ characters, openssl rand -hex 32) put in the webhook URLs as ?token=…
POD_WEBHOOK_SECRET="replace_with_random_secret"
# Protects /api/cron/pod (daily retry + tracking sync). Vercel Cron sends it automatically when set.
CRON_SECRET="replace_with_random_secret"
# Optional: "false" = paid orders wait for an admin to send them (default: sent automatically)
# POD_AUTO_SUBMIT="false"

# ── Prodigi (cards, magnets) ───────────────────────────────────────────────────
# Test mode uses the sandbox key (api.sandbox.prodigi.com, its own key from the sandbox dashboard).
PRODIGI_SANDBOX_API_KEY="replace_me"
# Live key: only read when POD_ORDER_MODE=live. Leave unset until go-live.
# PRODIGI_API_KEY="replace_me"

# ── Gelato (wall art, calendars) ───────────────────────────────────────────────
# One key; orders are created as drafts while POD_ORDER_MODE=draft.
GELATO_API_KEY="replace_me"

# ── Printful (mugs) ────────────────────────────────────────────────────────────
# Private token; orders are created unconfirmed while POD_ORDER_MODE=draft.
PRINTFUL_PRIVATE_TOKEN="replace_me"
# Only needed if the token is account-level (store-level tokens do not need it):
# PRINTFUL_STORE_ID="replace_me"

# ── Printeers (phone cases): TEST environment, API v1 ──────────────────────────
# While POD_ORDER_MODE=draft: test server https://api.test-printeers.com with the test partner code + key.
PRINTEERS_V1_TEST_PARTNER_CODE="replace_me"
PRINTEERS_V1_TEST_API_KEY="replace_me"
# Signing secret ("whsec_…") of the endpoint registered in dashboard.test-printeers.com → Settings → Webhooks:
# https://<site>/api/webhooks/printeers (the store's "API Callback URL" can point to the same address).
PRINTEERS_TEST_WEBHOOK_SECRET="whsec_replace_me"
#
# Printeers LIVE (only read when POD_ORDER_MODE=live; do NOT set until live mode is enabled):
# PRINTEERS_V1_PARTNER_CODE="replace_me"
# PRINTEERS_V1_API_KEY="replace_me"
# PRINTEERS_WEBHOOK_SECRET="whsec_replace_me"
#
# Printeers API v2 is DISABLED. It only switches on with PRINTEERS_API_VERSION="v2" AND the environment's
# secret key (a key alone changes nothing). Do not set these until v2 is deliberately enabled:
# PRINTEERS_API_VERSION="v2"
# PRINTEERS_TEST_API_KEY="Secret_Key_replace_me"      (test server)
# PRINTEERS_API_KEY="Secret_Key_replace_me"           (production)
# PRINTEERS_TEST_STORE_REFERENCE / PRINTEERS_STORE_REFERENCE  (only if the key has several stores)
#
# Printeers optional: minimal dropship level normal | tracked (default) | premium, and brand for the packaging.
# PRINTEERS_SHIPPING_LEVEL="tracked"
# PRINTEERS_TEST_BRAND_REFERENCE / PRINTEERS_BRAND_REFERENCE

# ── Optional base URL overrides (the defaults are correct; only for proxies / mock servers) ─────
# PRODIGI_BASE_URL (https://api.prodigi.com/v4.0)   PRODIGI_SANDBOX_BASE_URL (https://api.sandbox.prodigi.com/v4.0)
# GELATO_BASE_URL (https://order.gelatoapis.com)    PRINTFUL_BASE_URL (https://api.printful.com)
# PRINTEERS_TEST_BASE_URL (https://api.test-printeers.com)   PRINTEERS_BASE_URL (https://api.printeers.com)
#
# Set automatically by Vercel (never add them yourself): VERCEL, VERCEL_ENV, VERCEL_URL, NODE_ENV.
