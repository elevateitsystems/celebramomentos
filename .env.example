# Copy to .env.local for local development and fill in real values.
# Production values live in Vercel → Project Settings → Environment Variables.
# Never commit real secrets. Only NEXT_PUBLIC_* values are exposed to the browser.

# PostgreSQL (Neon). Prisma CLI commands (db:migrate, db:deploy) read .env, so
# also put DATABASE_URL in .env locally.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# Stripe (server-side only). Use sk_test_/pk_test_ keys locally.
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_SECRET_KEY="sk_test_replace_me"
# Local: from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Production: signing secret of the https://www.celebra-momentos.com/api/stripe/webhook endpoint
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# PayPal Checkout (Orders v2, server-side only — never prefix with NEXT_PUBLIC_).
# Create a REST app at https://developer.paypal.com/dashboard/applications and copy
# its Client ID and Secret. Sandbox and Live apps have different credentials.
PAYPAL_CLIENT_ID="replace_me"
PAYPAL_CLIENT_SECRET="replace_me"
# "sandbox" (default, test payments) or "live" (real payments, Live app credentials)
PAYPAL_MODE="sandbox"

# Cloudinary (server-side only)
CLOUDINARY_CLOUD_NAME="replace_me"
CLOUDINARY_API_KEY="replace_me"
CLOUDINARY_API_SECRET="replace_me"

# Session signing secret, at least 32 characters. Generate with: openssl rand -hex 32
# Use a different value in production.
AUTH_SECRET="replace_with_at_least_32_random_characters"
# Bootstrap owner account for /admin/login. Use a strong password in production.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="12345678"

# SMTP (optional, not used by the app yet)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace_me"
SMTP_PASSWORD="replace_me"
SMTP_FROM="Celebra Momentos <no-reply@example.com>"

# Public base URL used for Stripe and PayPal return/cancel redirects.
# Local: http://localhost:3000   Production: https://www.celebra-momentos.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
